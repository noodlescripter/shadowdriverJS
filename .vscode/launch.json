{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program with Arguments",
      "program": "${workspaceFolder}/src/shadowRunner/runner.js", // Path to your Node.js file
      "args": [
        "shadow.conf.js",
        "--suite",
        "dummyTest"
      ],
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    }
  ]
}