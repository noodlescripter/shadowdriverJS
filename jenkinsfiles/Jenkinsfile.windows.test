pipeline {
    agent { label 'shadowdriverJS-release-node' }
    
    tools {
        nodejs 'NodeJS' 
    }
    environment {
        GIT_REPO = 'git@github.com:noodlescripter/shadowdriverJS.git'
    }

    stages {
        stage('Clean up the workspace') {
            steps {
                echo 'Cleaning the previous workspace'
                cleanWs()
            }
        }

        stage('Cloning code base') {
            steps {
                echo "Cloning...... ${GIT_REPO}"
                git branch: "${BRANCH}", url: "${GIT_REPO}"
            }
        }

        stage('Install dependencies') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    echo 'Installing dependencies...'
                    bat 'npm i'
                }
            }
        }   


        stage('Prepare the shadowdriverjs build to UI test'){
            steps {
                echo 'build shadowdriverjs with bable'
                bat 'npm run build'
            }
        }

        stage('Download chrome browser'){
            steps{
                echo 'Downloading chromedriver and browser'
                bat 'node ./package/downloader/downloader.js'
            }
        }

        stage('Run ui test'){
            steps {
                echo 'UI TEST step'
                bat 'node ./package/shadowRunner/runner.js exec shadow.conf.win.js --spec e2e/sample.spec3.js'
            }
        }

    }

    post {
        always {
            echo 'Cleaning up after the run...'
        }
        success {
            echo 'Build and tests completed successfully!'
        }
        failure {
            echo 'Build or tests failed.'
        }
    }
}
